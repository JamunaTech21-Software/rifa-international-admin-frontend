# Base URL of the PHP API. In development the Vite dev server proxies /api to http://localhost:8000.
# On Vercel keep /api (see README → Deploying to Vercel for the proxy middleware).
VITE_API_BASE_URL=/api

# Cloudinary cloud name, only used to show job photos in the admin panel (same value as the public site).
VITE_CLOUDINARY_CLOUD_NAME=
